                    background: card.featured ? "#ffffff" : "#1b4332",
                    color: card.featured ? "#1b4332" : "#ffffff",
                  }}
                >
                  {card.cta}
                </a>
              </div>
            </motion.div>
          ))}
        </div>
      </div>
      <style dangerouslySetInnerHTML={{ __html: badgeStyles }} />

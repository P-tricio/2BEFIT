{
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/entrenamiento-presencial", "destination": "/entrenamiento-presencial/index.html" },
    { "source": "/entrenador-personal-marbella", "destination": "/entrenador-personal-marbella/index.html" },
    { "source": "/entrenador-personal-estepona", "destination": "/entrenador-personal-estepona/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
